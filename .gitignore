# Secrets — never commit
.env
*.pem

# Databases
*.sqlite3
*.sqlite3-journal

# Data and large artifacts
# The whole data/ tree: the corpus is Parquet under data/corpus/, which the
# earlier raw/ and interim/ entries did not cover.
data/
# Model binaries. metadata.json alongside them stays committable, so an
# artifact can report its own measured metrics without shipping the weights.
ml/artifacts/**/*.onnx
ml/artifacts/**/*.joblib

# collectstatic output — a build artifact, not source
staticfiles/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# SDD scratch workspace
.superpowers/
